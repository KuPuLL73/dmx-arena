{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "dmx-arena-connector",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "durable_objects": {"bindings": [{"name": "CONNECTOR", "class_name": "GameConnector"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["GameConnector"]}],
  "observability": {"enabled": false},
  // Separate test Worker with its own storage and secrets: deploy with `--env test`.
  // A plain `wrangler deploy` still targets only the live Worker above.
  "env": {
    "test": {
      "name": "dmx-arena-connector-test",
      "vars": {"DMX_INSTANCE": "test"},
      "durable_objects": {"bindings": [{"name": "CONNECTOR", "class_name": "GameConnector"}]}
    }
  }
}
